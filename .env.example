# Infrahub server URL (used by SDK and Streamlit catalog)
INFRAHUB_ADDRESS="http://localhost:8000"

# API token (demo only — rotate before any non-local use)
INFRAHUB_API_TOKEN="06438eb2-8019-4776-878c-0941b1f1d1ec"

# Streamlit-side UI URL for links back to Infrahub
INFRAHUB_UI_URL="http://localhost:8000"

# Use local repo for generator/transform code (no GitHub clone needed)
INFRAHUB_GIT_LOCAL="false"

# Repository and ref the server clones when INFRAHUB_GIT_LOCAL is "false".
# Defaults: the opsmill repository, and the branch checked out here.
# INFRAHUB_REPO_URL="https://github.com/opsmill/infrahub-demo-sp.git"
# INFRAHUB_REPO_REF="main"

# Set to "true" to start the Streamlit service-catalog sidecar on every
# `uv run invoke start` / `uv run invoke init`. It runs the published image
# from registry.opsmill.io.
INFRAHUB_SERVICE_CATALOG="false"

# Set to "true" to build the service-catalog and Batfish runner images from
# this checkout instead of pulling the published ones, and to mount their
# sources so local edits under service_catalog/ are picked up.
INFRAHUB_SERVICE_CATALOG_BUILD="false"

# Customer-facing dataset that `invoke bootstrap` / `invoke init` loads
# on top of the shared backbone. One subdirectory of `objects/datasets/`:
#   financial — internal bank with 8 division tenants (default)
#   isp                — Lumina Networks pan-European ISP with 8 customer tenants
INFRAHUB_DATASET="financial"

# Set to "true" to pull the Enterprise edition compose file
# (https://infrahub.opsmill.io/enterprise/<version>) instead of the
# Community edition. Requires an Enterprise license / pull credentials.
INFRAHUB_ENTERPRISE="false"

# Port overrides (set when running parallel instances)
# INFRAHUB_PORT=8000
# PREFECT_PORT=4200
# STREAMLIT_PORT=8501

# Pin or replace the published images (default tag: main)
# STREAMLIT_IMAGE=registry.opsmill.io/opsmill/infrahub-demo-sp-streamlit:main
# BATFISH_RUNNER_IMAGE=registry.opsmill.io/opsmill/infrahub-demo-sp-batfish-runner:main

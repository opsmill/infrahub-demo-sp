{# Format a /31 or /30 IP for vendor display (strip mask if requested). #}
{% macro ip_only(address) -%}
{{ address.split('/')[0] }}
{%- endmacro %}

{% macro mask_only(address) -%}
{{ address.split('/')[1] }}
{%- endmacro %}

{# PE-CE eBGP peer AS for an L3VPN site node. The site's `bgp_peer_asn` is an
   optional per-site override; otherwise the VPN's `customer_asn` applies,
   which the generator allocates from `customer_asn_pool`. Mirrors
   _resolve_site_peer_as in generators/generate_l3vpn.py.

   Tested with `is not none`, not truthiness: the generator decides whether to
   allocate a customer AS with `... is None`, so it treats bgp_peer_asn 0 as an
   override and links no `customer_asn`. An `or` here would disagree and fall
   through to the absent customer_asn.

   That fall-through aborts the render, and it does so for every shape the
   server produces for an unset relationship — `{"node": null}`, `null`, or the
   key absent — because attribute access on Jinja's Undefined raises whether or
   not the Environment is strict. Only *printing* an Undefined is silent, and
   this expression never stops at one.

   The transforms do set `undefined=StrictUndefined` as well, which closes the
   one remaining shape: a mapping that reaches `.asn` but has no `value` key
   renders empty under the default Undefined. The server does not produce that,
   so this is depth rather than a fix — but it also turns any mistyped path in
   any template into a loud failure instead of a blank line in a device
   configuration. #}
{% macro peer_asn(site) -%}
{% if site.bgp_peer_asn.value is not none -%}
{{ site.bgp_peer_asn.value }}
{%- else -%}
{{ site.l3vpn.node.customer_asn.node.asn.value }}
{%- endif %}
{%- endmacro %}

{# Shared cEOS lab access block: hostname, the demo admin user, eAPI over plain
   HTTP, and SSH. Identical on a PE and a CE — `invoke lab.push-arista` pushes to
   both over the same eAPI, so both need the same credentials and the same
   management settings. Kept here rather than duplicated per template so the demo
   secret and the HTTP-vs-HTTPS choice have exactly one home. #}
{% macro eos_lab_access(device) -%}
hostname {{ device.name.value }}
!
! Demo-only: admin user so the lab cEOS container accepts SSH password
! auth and `invoke lab.push-arista` can reach it. Replace before any
! non-local use.
username admin privilege 15 role network-admin secret 0 admin
!
management api http-commands
   no shutdown
   ! Demo-only: enable plain HTTP so `invoke lab.push-arista` can POST
   ! without negotiating cEOS-lab's auto-generated self-signed cert
   ! against modern Python TLS. Disable for any non-local use.
   protocol http
   no protocol https
!
management ssh
   no shutdown
!
{%- endmacro %}

{# Filter interfaces by role. #}
{% macro core_interfaces(interfaces) -%}
{% for iface in interfaces if iface.node.role.value == 'core' -%}
{{ iface.node.name.value }}
{% endfor %}
{%- endmacro %}

{# Map our generic Ethernet<N> interface name onto a Cisco IOS-XR port name.
   Schema is 1-indexed; IOS-XR ports are 0-indexed under 0/0/0/N, so
   Ethernet1 → GigabitEthernet0/0/0/0. Loopbacks pass through unchanged. #}
{% macro iosxr_iface(name) -%}
{%- if name.startswith('Loopback') -%}{{ name }}
{%- else -%}GigabitEthernet0/0/0/{{ name | replace('Ethernet', '') | int - 1 }}
{%- endif -%}
{%- endmacro %}

{# Map our generic Ethernet<N> interface name onto a Junos port name.
   Schema is 1-indexed; Junos `ge-` units are 0-indexed under ge-0/0/N,
   so Ethernet1 → ge-0/0/0. Loopback is the Junos-special lo0. #}
{% macro junos_iface(name) -%}
{%- if name.startswith('Loopback') -%}lo0
{%- else -%}ge-0/0/{{ name | replace('Ethernet', '') | int - 1 }}
{%- endif -%}
{%- endmacro %}

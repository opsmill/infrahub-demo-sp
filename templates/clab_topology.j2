{% set backbone = data.TopologyMplsBackbone.edges[0].node %}
{# `labbed_pes` (the lab-deployable PE nodes) is supplied by the transform so
   the "which PEs are lab-deployable" rule lives in one place — see
   transforms/clab_topology.py:_labbed_pes. #}
{# Translate an Infrahub interface name (e.g. "Ethernet4") to the form clab
   needs for the link endpoint, based on the container kind.
   - ceos: data ports are eth1, eth2, ... (clab maps eth<N> ↔ Ethernet<N>)
   - srl:  data ports must match ethernet-L/P (we use line card 1)
   - any other kind: pass the name through. #}
{% macro clab_iface(name, kind) -%}
{%- set port = name | replace('Ethernet', '') -%}
{%- if kind == 'ceos' -%}eth{{ port }}
{%- elif kind == 'srl' -%}ethernet-1/{{ port }}
{%- else -%}{{ name }}
{%- endif -%}
{% endmacro %}
# Containerlab topology for the {{ backbone.name.value }} backbone.
# Only devices whose platform has containerlab_os set are included — the
# backbone PEs plus the pre-provisioned CE routers attached to them.
# Nokia SR OS is substituted to SR Linux (`srl`) because the lab uses
# the publicly available SR Linux image; the per-PE config artifact
# still renders SR OS canon for the engineer audience.
---
name: {{ backbone.name.value }}

# Pin the management bridge to a subnet that doesn't overlap the
# sp-demo Infrahub compose network (172.20.0.0/16). Containerlab's
# default 172.20.20.0/24 sits inside that range and Docker refuses
# to create the bridge.
mgmt:
  network: clab-{{ backbone.name.value }}
  ipv4-subnet: 172.100.20.0/24
  ipv6-subnet: 3fff:172:100:20::/64

topology:
  defaults:
    env:
      LAB_NAME: {{ backbone.name.value }}

  kinds:
    ceos:
      # OpsMill-hosted public mirror; the upstream Arista cEOS image
      # is gated by login. Matches the image used by infrahub-demo-dc.
      #
      # Must stay >= 4.32.0F. Older cEOS-lab builds require a cgroups v1 host
      # and silently fail to boot on a cgroups v2 one (the default on Ubuntu
      # 21.04+, OrbStack and most current distros): the container starts, EOS
      # never comes up, and `containerlab deploy` blocks forever in
      # "Running postdeploy actions" because that step waits on the EOS CLI.
      # 4.32.0F is where cEOS-lab began detecting the host's cgroup version
      # itself. See docs/docs/troubleshooting.mdx.
      #
      # Resolved through CEOS_IMAGE (containerlab expands ${VAR:=default}
      # anywhere in the topology) because the mirror publishes no multi-arch
      # tag: the default below is amd64, and arm64 hosts need a different tag
      # entirely. `invoke lab.deploy` sets CEOS_IMAGE from the host arch, so
      # the artifact Infrahub renders stays host-independent.
      image: "${CEOS_IMAGE:=registry.opsmill.io/external/ceos-image:4.36.0.1F}"
    srl:
      image: ghcr.io/nokia/srlinux:23.10
    linux:
      # Simulated customer machines on the CE LAN side. netshoot carries
      # iproute2, so it can tag its own frames with the customer VLAN.
      image: nicolaka/netshoot:latest

  nodes:
{% for pe in labbed_pes %}
    {{ pe.name.value }}:
      kind: {{ pe.platform.node.containerlab_os.value }}
      startup-config: devices/{{ pe.name.value }}.cfg
{% endfor %}
{# Pre-provisioned CE routers. `ce_attachments` comes from the transform (see
   transforms/clab_topology.py:_ce_attachments) and only contains sites whose
   CE, CE port, and generator-allocated PE port are all present and
   lab-deployable. They boot the same way the PEs do — from a rendered config
   artifact — so the PE-CE eBGP session actually comes up in the lab. #}
{# Declared once per CE, not once per attachment: a CE terminating two sites
   appears in `ce_attachments` twice, and a repeated mapping key is a duplicate
   YAML key that containerlab will not accept. Links below still need one entry
   per attachment, so only the node declaration is deduplicated. #}
{% set declared_ces = [] %}
{% for attachment in ce_attachments if attachment.ce.device not in declared_ces %}
{% set _ = declared_ces.append(attachment.ce.device) %}
    {{ attachment.ce.device }}:
      kind: {{ attachment.ce.kind }}
      startup-config: devices/{{ attachment.ce.device }}.cfg
{% endfor %}
{# Simulated customer machines. Without one attached, the CE LAN port has no
   carrier: it stays down, the dot1q sub-interface sits lowerlayerdown, and the
   customer prefix is never advertised (a down interface contributes no
   connected route for the BGP `network` statement to match). Each host tags
   with the same VLAN the CE expects, so the encapsulation is exercised rather
   than merely configured. See transforms/clab_topology.py:_lan_hosts. #}
{% for host in lan_hosts %}
    {{ host.name }}:
      kind: linux
      exec:
        - ip link set eth1 up
        - ip link add link eth1 name eth1.{{ host.vlan }} type vlan id {{ host.vlan }}
        - ip link set eth1.{{ host.vlan }} up
        - ip addr add {{ host.address }} dev eth1.{{ host.vlan }}
        # 'replace' not 'add': the container already has a default route via the
        # clab management bridge, and 'add' fails with RTNETLINK File exists.
        - ip route replace default via {{ host.gateway }}
{% endfor %}

  links:
{# Backbone p2p links, derived in the transform by pairing the core
   interfaces of lab-deployable PEs that share a /31. Renders every backbone
   link whose two endpoints are both lab-deployable (all of them when the
   backbone is single-vendor cEOS; only the Arista↔Nokia link in the mixed
   ISP dataset). #}
{% for link in backbone_links %}
    - endpoints: ["{{ link.endpoints[0].device }}:{{ clab_iface(link.endpoints[0].iface, link.endpoints[0].kind) }}", "{{ link.endpoints[1].device }}:{{ clab_iface(link.endpoints[1].iface, link.endpoints[1].kind) }}"]
{% endfor %}
{# PE-CE access links, one per attachment above. #}
{% for attachment in ce_attachments %}
    - endpoints: ["{{ attachment.pe.device }}:{{ clab_iface(attachment.pe.iface, attachment.pe.kind) }}", "{{ attachment.ce.device }}:{{ clab_iface(attachment.ce.iface, attachment.ce.kind) }}"]
{% endfor %}
{# CE-to-customer LAN links. These give the CE private port carrier. #}
{% for host in lan_hosts %}
    - endpoints: ["{{ host.ce.device }}:{{ clab_iface(host.ce.iface, host.ce.kind) }}", "{{ host.name }}:eth1"]
{% endfor %}

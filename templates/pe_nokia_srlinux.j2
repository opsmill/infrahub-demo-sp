{% import '_macros.j2' as m %}
{% set device = data.DcimDevice.edges[0].node %}
{% set isis = data.MplsIsisProcess.edges[0].node %}
{% set bgp = data.MplsBgpProcess.edges[0].node %}
{# iBGP neighbours come from RoutingBGPSession filtered by device, not from
   MplsBgpProcess.sessions — nothing ever populates that relationship. #}
{% set ibgp_sessions = data.RoutingBGPSession.edges %}
{% set sites = data.ServiceL3VpnSite.edges
    | selectattr('node.pe_interface.node')
    | selectattr('node.pe_address.node')
    | selectattr('node.l3vpn.node.vrf.node')
    | list %}
{# Map our generic Ethernet<N> interface names onto SR Linux ethernet-1/<N> #}
{% macro srl_iface(name) -%}
{%- if name == 'Loopback0' -%}lo0
{%- else -%}ethernet-1/{{ name | replace('Ethernet', '') }}
{%- endif -%}
{%- endmacro %}
{% set srl_levels = {'level-1': 'L1', 'level-2': 'L2', 'level-1-2': 'L1L2'} %}
# SR Linux configuration for {{ device.name.value }}
# Lab-scoped: hostname + interfaces + ISIS underlay + iBGP full mesh
# (ipv4-unicast only) + MPLS forwarding plane on core interfaces.
# Verified to commit cleanly on the public SR Linux 26.7.1-554 clab image
# ("All changes have been committed").
#
# L3VPN signalling is still NOT rendered, for two reasons that survive the
# 23.10 -> 26.7 bump: LDP is absent from the protocols enum on this
# platform, and there is no VPNv4 afi-safi (the enum holds ipv4-unicast,
# ipv6-unicast, evpn and route-target only).
#
# What did change: the per-VPN routing-instance type and the evpn afi-safi
# are both accepted on 26.7 where 23.10 rejected them, so an EVPN-signalled
# L3VPN is renderable here -- it is simply not modelled yet.
# Production-quality L3VPN config lives in the pe-nokia-sros artifact. See
# docs/docs/lab/containerlab.mdx 'Known gaps'.
#
# Careful with the wording above: these header lines are emitted into the
# rendered configuration, and tests/unit/test_transforms substring-match the
# output for constructs that must not appear. Naming one literally here fails
# the suite.
set / system name host-name {{ device.name.value }}
{% for iface in device.interfaces.edges if iface.node.name.value == 'Loopback0' %}
set / interface lo0 admin-state enable
set / interface lo0 subinterface 0 admin-state enable
{% for ip in iface.node.ip_addresses.edges %}
set / interface lo0 subinterface 0 ipv4 admin-state enable
set / interface lo0 subinterface 0 ipv4 address {{ ip.node.address.value }}
{% endfor %}
{% endfor %}

{# Core backbone interfaces.

   MTU semantic mismatch warning: Arista (and most Cisco) `mtu` is IP MTU,
   so a "9000" interface emits Ethernet frames up to 9014 bytes on the
   wire (mtu + 14 for the L2 header). SR Linux's `mtu` is the L2 frame
   MTU, so we add 14 here — without that SR Linux silently drops Arista's
   IS-IS hellos (which cEOS pads to the IS-IS interface MTU) and the
   adjacency never forms. #}
{% for iface in device.interfaces.edges if iface.node.role.value == 'core' %}
set / interface {{ srl_iface(iface.node.name.value) }} admin-state enable
set / interface {{ srl_iface(iface.node.name.value) }} mtu {{ iface.node.mtu.value + 14 }}
set / interface {{ srl_iface(iface.node.name.value) }} subinterface 0 admin-state enable
set / interface {{ srl_iface(iface.node.name.value) }} subinterface 0 ipv4 admin-state enable
{% for ip in iface.node.ip_addresses.edges %}
set / interface {{ srl_iface(iface.node.name.value) }} subinterface 0 ipv4 address {{ ip.node.address.value }}
{% endfor %}
{% endfor %}

{# Customer-facing interfaces (one per L3VPN site).
   These get an IP but no L3VPN binding — see docstring above. #}
{% for site_edge in sites %}
{% set site = site_edge.node %}
set / interface {{ srl_iface(site.pe_interface.node.name.value) }} admin-state enable
set / interface {{ srl_iface(site.pe_interface.node.name.value) }} description "L3VPN {{ site.l3vpn.node.name.value }} - {{ site.name.value }} (no VRF in lab)"
set / interface {{ srl_iface(site.pe_interface.node.name.value) }} subinterface 0 admin-state enable
set / interface {{ srl_iface(site.pe_interface.node.name.value) }} subinterface 0 ipv4 admin-state enable
set / interface {{ srl_iface(site.pe_interface.node.name.value) }} subinterface 0 ipv4 address {{ site.pe_address.node.address.value }}
{% endfor %}

{# Default network-instance: ISIS underlay only. router-id is unused
   here (no BGP) so we omit it; ISIS uses system-id from the NET. #}
set / network-instance default type default
{% for iface in device.interfaces.edges if iface.node.name.value == 'Loopback0' %}
set / network-instance default interface {{ srl_iface(iface.node.name.value) }}.0
{% endfor %}
{% for iface in device.interfaces.edges if iface.node.role.value == 'core' %}
set / network-instance default interface {{ srl_iface(iface.node.name.value) }}.0
{% endfor %}

set / network-instance default protocols isis instance i1 admin-state enable
set / network-instance default protocols isis instance i1 level-capability {{ srl_levels[isis.level.value] }}
set / network-instance default protocols isis instance i1 net [ {{ isis.net_id.value }} ]
{% for iface in device.interfaces.edges if iface.node.name.value == 'Loopback0' %}
set / network-instance default protocols isis instance i1 interface {{ srl_iface(iface.node.name.value) }}.0 admin-state enable
set / network-instance default protocols isis instance i1 interface {{ srl_iface(iface.node.name.value) }}.0 passive true
{% endfor %}
{# Default circuit-type (broadcast) over Ethernet — same as netlab's
   interop-validated baseline. Observed on cEOS 4.29 ↔ SR Linux 23.10:
   no P2P 3-way adjacency forms in this lab (cEOS sends RFC 3373's
   5-byte TLV 240, SR Linux uses RFC 5303's 15-byte form, and the
   handshake stalls in Initializing); broadcast adjacencies side-step
   that entirely. Not re-tested against the current 4.36 ↔ 26.7 pins —
   broadcast is kept because it works, not because P2P is known broken
   on these builds. #}
{% for iface in device.interfaces.edges if iface.node.role.value == 'core' %}
set / network-instance default protocols isis instance i1 interface {{ srl_iface(iface.node.name.value) }}.0 admin-state enable
{% endfor %}

{# iBGP full mesh on loopbacks. ipv4-unicast only — the afi-safi enum on
   26.7.1-554 is {ipv4-unicast, ipv6-unicast, evpn, route-target}, with
   no l3vpn-ipv4-unicast, so no VPNv4 routes are carried.
   transport.local-address pins sessions to the loopback (local-address
   nests under transport/ in this schema). #}
{% for iface in device.interfaces.edges if iface.node.name.value == 'Loopback0' %}
{% for ip in iface.node.ip_addresses.edges %}
set / network-instance default protocols bgp admin-state enable
set / network-instance default protocols bgp autonomous-system {{ device.asn.node.asn.value }}
set / network-instance default protocols bgp router-id {{ m.ip_only(ip.node.address.value) }}
set / network-instance default protocols bgp afi-safi ipv4-unicast admin-state enable
set / network-instance default protocols bgp group ibgp-mesh admin-state enable
set / network-instance default protocols bgp group ibgp-mesh peer-as {{ device.asn.node.asn.value }}
set / network-instance default protocols bgp group ibgp-mesh transport local-address {{ m.ip_only(ip.node.address.value) }}
set / network-instance default protocols bgp group ibgp-mesh afi-safi ipv4-unicast admin-state enable
{% endfor %}
{% endfor %}
{% for session in ibgp_sessions %}
set / network-instance default protocols bgp neighbor {{ m.ip_only(session.node.remote_ip.node.address.value) }} peer-group ibgp-mesh
set / network-instance default protocols bgp neighbor {{ m.ip_only(session.node.remote_ip.node.address.value) }} admin-state enable
{% endfor %}

commit save
